#: templates/admin-documentation.php:117
msgid "The wizard guides you step by step through creating a discount rule:"
msgstr "האשף מנחה אתכם צעד אחר צעד ביצירת כלל הנחה:"

#: templates/admin-documentation.php:119
msgid "<strong>Step 1 - Basic settings:</strong> name the rule, enable it, and choose which item the discount applies to (the cheapest or the most expensive)."
msgstr "<strong>צעד 1 - הגדרות בסיסיות:</strong> תנו שם לכלל, הפעילו אותו, ובחרו על איזה פריט תחול ההנחה (הזול או היקר ביותר)."

#: templates/admin-documentation.php:120
msgid "<strong>Step 2 - Product selection:</strong> choose how to identify eligible products: all products, by category, by product ID, or by attribute."
msgstr "<strong>צעד 2 - בחירת מוצרים:</strong> בחרו באיזו שיטה לזהות את המוצרים הזכאים - כל המוצרים, לפי קטגוריה, לפי מזהה מוצר, או לפי תכונה."

#: templates/admin-documentation.php:121
msgid "<strong>Step 3 - Discount tiers:</strong> set the discount tiers: how many items must be bought and what percentage/amount to give."
msgstr "<strong>צעד 3 - כללי הנחה:</strong> הגדירו את רמות ההנחה - כמה פריטים צריך לקנות וכמה אחוזים/סכום הנחה לתת."

#: templates/admin-documentation.php:122
msgid "<strong>Step 4 - Messages:</strong> set messages shown to customers on the product page and in the cart."
msgstr "<strong>צעד 4 - הודעות:</strong> הגדירו הודעות שיוצגו ללקוחות בדף המוצר ובעגלת הקניות."

#: templates/admin-documentation.php:123
msgid "<strong>Step 5 - Conditions:</strong> add advanced conditions such as a minimum cart total, user role, scheduling and usage limits."
msgstr "<strong>צעד 5 - תנאים:</strong> הוסיפו תנאים מתקדמים כמו סכום עגלה מינימלי, תפקיד משתמש, תזמון, ומגבלות שימוש."

#: templates/admin-documentation.php:125
msgid "To start the wizard, click <strong>\"Create with wizard\"</strong> on the rules list page."
msgstr "כדי להפעיל את האשף, לחצו על <strong>\"צור עם אשף\"</strong> בדף רשימת הכללים."

